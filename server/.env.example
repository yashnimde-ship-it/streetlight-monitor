PORT=5000

# Leave empty in development to use a temporary in-memory MongoDB (auto-seeded on start).
# Set to your Atlas connection string for persistent data / production, e.g.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/streetlight-monitor
MONGODB_URI=

# Required in production. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Allowed web origin(s), comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Admin account created on first start
ADMIN_EMAIL=admin@streetlight.local
ADMIN_PASSWORD=change-me
